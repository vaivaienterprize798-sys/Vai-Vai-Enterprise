{
  "entities": {
    "Invoice": {
      "title": "Invoice",
      "description": "Sales, purchase, processing, or commercial trade invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "invoiceNo": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["general", "processing", "dokan", "commercial"] },
        "mode": { "type": "string", "enum": ["purchase", "sales"] },
        "partyId": { "type": "string", "maxLength": 128 },
        "partyName": { "type": "string", "maxLength": 200 },
        "partyPhone": { "type": "string", "maxLength": 50 },
        "partyAddress": { "type": "string", "maxLength": 300 },
        "date": { "type": "string", "maxLength": 50 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "courierDeduction": { "type": "number" },
        "discount": { "type": "number" },
        "netInvoiceAmount": { "type": "number" },
        "previousBalance": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingDue": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["paid", "unpaid", "partial"] },
        "paymentMethod": { "type": "string", "enum": ["cash", "bKash", "nagad", "bank", "courier_cod"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "invoiceNo", "type", "mode", "partyName", "date", "subtotal", "grandTotal"]
    },
    "StockItem": {
      "title": "StockItem",
      "description": "Inventory motherboard or circuit stock item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["code", "android", "kg", "pcs_blank"] },
        "nameBn": { "type": "string", "maxLength": 255 },
        "nameEn": { "type": "string", "maxLength": 255 },
        "code": { "type": "string", "maxLength": 100 },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "enum": ["pcs", "kg"] },
        "purchaseRate": { "type": "number" },
        "purchaseAvgRate": { "type": "number" },
        "saleRate": { "type": "number" },
        "minAlertQty": { "type": "number" },
        "lastUpdated": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "category", "nameBn", "code", "quantity", "unit", "purchaseRate"]
    },
    "Party": {
      "title": "Party",
      "description": "Supplier, buyer or dual trading counterparty ledger profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "type": { "type": "string", "enum": ["supplier", "buyer", "both"] },
        "openingBalance": { "type": "number" },
        "currentDue": { "type": "number" },
        "currentAdvance": { "type": "number" },
        "totalTransactions": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "name", "phone", "address", "type"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Office or processing technician employee profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "enum": ["office", "processing"] },
        "designation": { "type": "string", "maxLength": 200 },
        "baseSalary": { "type": "number" },
        "dailyRate": { "type": "number" },
        "joinDate": { "type": "string", "maxLength": 50 },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "phone", "category", "designation", "baseSalary", "dailyRate", "active"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily employee attendance, late minutes and overtime calculation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "staffId": { "type": "string", "maxLength": 128 },
        "staffName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["office", "processing"] },
        "date": { "type": "string", "maxLength": 50 },
        "inTime": { "type": "string", "maxLength": 50 },
        "outTime": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["present", "late", "absent", "full_day_leave", "half_day_leave", "leave"] },
        "lateMinutes": { "type": "number" },
        "otHours": { "type": "number" },
        "otAmount": { "type": "number" },
        "advanceDeduction": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "staffId", "staffName", "date", "status"]
    },
    "PettyCashExpense": {
      "title": "PettyCashExpense",
      "description": "Daily shop and office cash expenditure voucher",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 1000 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "voucherNo": { "type": "string", "maxLength": 100 },
        "receiptNo": { "type": "string", "maxLength": 100 },
        "paidBy": { "type": "string", "maxLength": 100 },
        "paidTo": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "date", "category", "title", "amount"]
    },
    "CarExpense": {
      "title": "CarExpense",
      "description": "Pickup and transport vehicle maintenance and fuel vouchers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 100 },
        "vehicleNo": { "type": "string", "maxLength": 100 },
        "tripRoute": { "type": "string", "maxLength": 300 },
        "liter": { "type": "number" },
        "kilometers": { "type": "number" },
        "title": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 1000 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "voucherNo": { "type": "string", "maxLength": 100 },
        "receiptNo": { "type": "string", "maxLength": 100 },
        "driverName": { "type": "string", "maxLength": 100 },
        "paidTo": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "date", "category", "title", "amount"]
    },
    "DokanPayment": {
      "title": "DokanPayment",
      "description": "Direct shop purchases and due clearance vouchers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "recipientName": { "type": "string", "maxLength": 200 },
        "voucherNo": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "date", "amount", "paymentMethod"]
    },
    "CompanyInfo": {
      "title": "CompanyInfo",
      "description": "Business profile and contact details",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "processingName": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 500 },
        "phones": { "type": "array" },
        "businessTypeBn": { "type": "string", "maxLength": 300 },
        "businessTypeEn": { "type": "string", "maxLength": 300 },
        "tagline": { "type": "string", "maxLength": 300 },
        "proprietor": { "type": "string", "maxLength": 200 },
        "logoUrl": { "type": "string", "maxLength": 1000 },
        "invoiceTermsBn": { "type": "string", "maxLength": 2000 },
        "invoiceTermsEn": { "type": "string", "maxLength": 2000 }
      },
      "required": ["name", "email", "address"]
    },
    "SalaryPayment": {
      "title": "SalaryPayment",
      "description": "Month-wise staff salary payout record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "staffId": { "type": "string", "maxLength": 128 },
        "month": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Paid", "Unpaid"] }
      },
      "required": ["id", "staffId", "month", "status"]
    },
    "WorkerTaskRecord": {
      "title": "WorkerTaskRecord",
      "description": "Processing worker task tracking, given PCS, completed PCS and damaged PCS",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "workerId": { "type": "string", "maxLength": 128 },
        "workerName": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 50 },
        "productName": { "type": "string", "maxLength": 255 },
        "batchNo": { "type": "string", "maxLength": 100 },
        "sampleCode": { "type": "string", "maxLength": 100 },
        "supervisorId": { "type": "string", "maxLength": 128 },
        "supervisorName": { "type": "string", "maxLength": 200 },
        "startTime": { "type": "string", "maxLength": 50 },
        "completionTime": { "type": "string", "maxLength": 50 },
        "durationMinutes": { "type": "number" },
        "isTimerRunning": { "type": "boolean" },
        "timerStartedAt": { "type": "string", "maxLength": 100 },
        "givenPcs": { "type": "number" },
        "completedPcs": { "type": "number" },
        "damagedPcs": { "type": "number" },
        "status": { "type": "string", "enum": ["assigned", "in_progress", "completed", "on_hold"] },
        "extractedProductSummary": { "type": "string", "maxLength": 1000 },
        "extractedItems": { "type": "array" },
        "damages": { "type": "array" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "workerId", "workerName", "date", "productName", "givenPcs", "completedPcs", "damagedPcs", "status"]
    },
    "BranchConsignment": {
      "title": "BranchConsignment",
      "description": "Electronics scrap parts dispatched to overseas/local branch office",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "consignmentNo": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 50 },
        "branchName": { "type": "string", "maxLength": 200 },
        "destinationCity": { "type": "string", "maxLength": 100 },
        "items": { "type": "array" },
        "totalBdtValue": { "type": "number" },
        "totalRmbEstimated": { "type": "number" },
        "shippingMethod": { "type": "string", "enum": ["Air Cargo", "Sea Cargo", "Hand Carry", "Courier", "Other"] },
        "trackingNo": { "type": "string", "maxLength": 100 },
        "carrierName": { "type": "string", "maxLength": 100 },
        "shippingCostBdt": { "type": "number" },
        "status": { "type": "string", "enum": ["dispatched", "in_transit", "received_at_branch", "sold"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "consignmentNo", "date", "branchName", "totalBdtValue", "status"]
    },
    "BranchRmbRemittance": {
      "title": "BranchRmbRemittance",
      "description": "RMB (Chinese Yuan) payments remitted by branch office from product sales",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "referenceNo": { "type": "string", "maxLength": 100 },
        "branchName": { "type": "string", "maxLength": 200 },
        "rmbAmount": { "type": "number" },
        "consignmentId": { "type": "string", "maxLength": 128 },
        "consignmentNo": { "type": "string", "maxLength": 100 },
        "receivedVia": { "type": "string", "enum": ["WeChat Pay", "Alipay", "Chinese Bank", "Cash", "Other"] },
        "accountDetails": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "date", "referenceNo", "branchName", "rmbAmount", "receivedVia"]
    },
    "ThirdPartyRmbConversion": {
      "title": "ThirdPartyRmbConversion",
      "description": "Conversion of RMB to BDT via 3rd party money changer agents and due tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "voucherNo": { "type": "string", "maxLength": 100 },
        "partyName": { "type": "string", "maxLength": 200 },
        "partyPhone": { "type": "string", "maxLength": 50 },
        "rmbAmountGiven": { "type": "number" },
        "exchangeRate": { "type": "number" },
        "expectedBdtAmount": { "type": "number" },
        "receivedBdtAmount": { "type": "number" },
        "remainingDueBdt": { "type": "number" },
        "settlementStatus": { "type": "string", "enum": ["settled", "partial", "pending"] },
        "paymentMethod": { "type": "string", "enum": ["bank_transfer", "cash", "bKash", "nagad", "multiple"] },
        "bankAccountDetails": { "type": "string", "maxLength": 300 },
        "historyPayments": { "type": "array" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "date", "voucherNo", "partyName", "rmbAmountGiven", "exchangeRate", "expectedBdtAmount", "receivedBdtAmount", "settlementStatus"]
    },
    "PunchLeaveRequest": {
      "title": "PunchLeaveRequest",
      "description": "Staff leave applications and punch correction requests for admin review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "staffId": { "type": "string", "maxLength": 128 },
        "staffName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["office", "processing"] },
        "requestType": { "type": "string", "enum": ["leave", "punch_fix"] },
        "date": { "type": "string", "maxLength": 50 },
        "leaveType": { "type": "string", "maxLength": 50 },
        "requestedInTime": { "type": "string", "maxLength": 50 },
        "requestedOutTime": { "type": "string", "maxLength": 50 },
        "reason": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "appliedAt": { "type": "string", "maxLength": 100 },
        "reviewedBy": { "type": "string", "maxLength": 200 },
        "reviewedAt": { "type": "string", "maxLength": 100 },
        "adminNotes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "staffId", "staffName", "requestType", "date", "reason", "status"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Document used to verify connectivity to Firestore",
      "type": "object",
      "properties": {
        "status": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string", "maxLength": 100 }
      },
      "required": ["status"]
    },
    "PriceList": {
      "title": "PriceList",
      "description": "Product price list with 3 pricing columns for market fluctuations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 255 },
        "date": { "type": "string", "maxLength": 50 },
        "companyName": { "type": "string", "maxLength": 200 },
        "companyAddress": { "type": "string", "maxLength": 500 },
        "items": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "archived"] }
      },
      "required": ["id", "title", "date", "companyName"]
    },
    "WorkerProductConversion": {
      "title": "WorkerProductConversion",
      "description": "Worker raw product yield and transformation records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "workerId": { "type": "string", "maxLength": 128 },
        "workerName": { "type": "string", "maxLength": 200 },
        "inputProduct": { "type": "string", "maxLength": 255 },
        "inputQty": { "type": "number" },
        "outputProduct": { "type": "string", "maxLength": 255 },
        "outputQty": { "type": "number" }
      },
      "required": ["id", "workerId", "inputProduct", "inputQty", "outputProduct", "outputQty"]
    }
  },
  "firestore": {
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Enterprise customer & supplier invoices"
    },
    "/stock/{stockId}": {
      "schema": { "$ref": "#/entities/StockItem" },
      "description": "Live inventory items and rates"
    },
    "/parties/{partyId}": {
      "schema": { "$ref": "#/entities/Party" },
      "description": "Customer and supplier ledger profiles"
    },
    "/staff/{staffId}": {
      "schema": { "$ref": "#/entities/Staff" },
      "description": "Staff roster and salary rates"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Daily employee attendance records"
    },
    "/pettyCash/{pettyCashId}": {
      "schema": { "$ref": "#/entities/PettyCashExpense" },
      "description": "Office petty cash daily expenditures"
    },
    "/carExpenses/{carExpenseId}": {
      "schema": { "$ref": "#/entities/CarExpense" },
      "description": "Pickup and vehicle operational costs"
    },
    "/dokanPayments/{dokanPaymentId}": {
      "schema": { "$ref": "#/entities/DokanPayment" },
      "description": "Dokan ledger transactions"
    },
    "/company/{companyId}": {
      "schema": { "$ref": "#/entities/CompanyInfo" },
      "description": "Enterprise brand and invoice details"
    },
    "/salaryPayments/{paymentId}": {
      "schema": { "$ref": "#/entities/SalaryPayment" },
      "description": "Staff monthly salary status records"
    },
    "/workerTasks/{taskId}": {
      "schema": { "$ref": "#/entities/WorkerTaskRecord" },
      "description": "Processing worker task tracking and wastage logs"
    },
    "/punchRequests/{requestId}": {
      "schema": { "$ref": "#/entities/PunchLeaveRequest" },
      "description": "Staff leave applications and punch fix requests"
    },
    "/branchConsignments/{consignmentId}": {
      "schema": { "$ref": "#/entities/BranchConsignment" },
      "description": "Dispatched consignments of parts from BD to branch office"
    },
    "/branchRemittances/{remittanceId}": {
      "schema": { "$ref": "#/entities/BranchRmbRemittance" },
      "description": "RMB sales payments received from branch office"
    },
    "/rmbConversions/{conversionId}": {
      "schema": { "$ref": "#/entities/ThirdPartyRmbConversion" },
      "description": "3rd party agent RMB to BDT conversions and ledger balance"
    },
    "/priceLists/{priceListId}": {
      "schema": { "$ref": "#/entities/PriceList" },
      "description": "Daily market price lists with 3 pricing columns"
    },
    "/workerConversions/{conversionId}": {
      "schema": { "$ref": "#/entities/WorkerProductConversion" },
      "description": "Worker output conversion and extraction records"
    },
    "/test/{testId}": {
      "schema": { "$ref": "#/entities/TestConnection" },
      "description": "Connection test document for health checks"
    }
  }
}
